{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://auther-production.up.railway.app/api/:path*" },
    { "source": "/sso/:path*", "destination": "https://auther-production.up.railway.app/sso/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
